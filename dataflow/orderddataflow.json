{
	"name": "orderddataflow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "sourcecsvfiles",
						"type": "DatasetReference"
					},
					"name": "ordersInputStream",
					"description": "Add source dataset "
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_json_order_output",
						"type": "DatasetReference"
					},
					"name": "sinkordersdata",
					"description": "destination the data here "
				}
			],
			"transformations": [
				{
					"name": "selectorders"
				},
				{
					"name": "aggregateordersdata"
				}
			],
			"scriptLines": [
				"source(output(",
				"          order_id as string,",
				"          order_date as string,",
				"          order_customer_id as string,",
				"          order_status as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> ordersInputStream",
				"ordersInputStream select(mapColumn(",
				"          order_id,",
				"          custome_id = order_customer_id,",
				"          order_status",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectorders",
				"selectorders aggregate(groupBy(order_status),",
				"     order_id = count(order_id)) ~> aggregateordersdata",
				"aggregateordersdata sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sinkordersdata"
			]
		}
	}
}